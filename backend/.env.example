NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=
# Optional extra frontend origin. The backend's vercel.json supplies this on Vercel.
GITHUB_PAGES_ORIGIN=

# Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-your-supabase-anon-key
# Server only. Never expose or commit a real service-role key.
SUPABASE_SERVICE_KEY=replace-with-your-supabase-service-role-key

# Generate a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-32-character-minimum-secret

# Optional AI integration
GEMINI_API_KEY=

# Password recovery supports resend (default) or smtp. Configure one before testing.
# All email credentials belong in the backend environment, never the frontend.
EMAIL_PROVIDER=resend
# For Resend, use a verified domain for real recipients. The shared resend.dev
# sender only permits tests to the Resend account owner's address.
RESEND_API_KEY=
EMAIL_FROM=EraEdu <onboarding@resend.dev>

# Alternative without buying a domain: set EMAIL_PROVIDER=smtp and use your mailbox.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and a Google App Password.
# Change EMAIL_FROM to that mailbox, or remove it to default to EraEdu <SMTP_USER>.
# Port 587 uses required STARTTLS. Port 465 uses TLS immediately. Port 25 is blocked.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LOG_LEVEL=debug

# Safepay Billing (server-side only)
# Sandbox and production credentials are different. Never commit real values.
SAFEPAY_ENV=sandbox
SAFEPAY_PUBLIC_KEY=sec_...
SAFEPAY_SECRET_KEY=replace-with-your-safepay-secret-key
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_EDUCATOR_PRICE_PKR=4999
